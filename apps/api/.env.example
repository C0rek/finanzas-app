# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube al repo (está en .gitignore).

# Conexión a Postgres: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Estos valores coinciden con docker-compose.yml (solo para desarrollo local).
DATABASE_URL="postgresql://finanzas:finanzas_dev@localhost:5432/finanzas"

# Carpeta con los datos reales (fuera del repo). Solo la usa `pnpm db:volcar`.
# Adentro espera historial/spot.csv y catalogo-activos.csv.
# DATA_DIR="C:/ruta/a/tus/datos"

# Clave de Finnhub para los precios de bolsa (https://finnhub.io). Plan gratuito.
# FINNHUB_API_KEY=""

# Claves de Bitunix: crealas con permiso de solo lectura.
# BITUNIX_API_KEY=""
# BITUNIX_SECRET_KEY=""
